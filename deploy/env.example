# Image reference used by docker-compose.deploy.yml.
# The deploy workflow rewrites this to a locally tagged image after pulling by digest.
CLI_PROXY_IMAGE=ghcr.io/baicie/cli-proxy-api:latest
# Host port published on 127.0.0.1; Caddy proxies to it from outside.
HOST_PORT=8317
# Timezone applied to the container.
TZ=Asia/Shanghai

# Docker bridge gateway of the peer gateway (new-api_default).
# The API also listens here so same-host gateways skip the public TLS path.
INTERNAL_BIND_IP=172.20.0.1
